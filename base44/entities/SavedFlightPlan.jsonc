{
  "name": "SavedFlightPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name des Flugplans"
    },
    "total_km": {
      "type": "number",
      "description": "Gesamtstrecke in km"
    },
    "stop_count": {
      "type": "number",
      "description": "Anzahl der Stationen"
    },
    "aircraft_id": {
      "type": "string",
      "description": "Zugeordnetes Flugzeug (ID)"
    },
    "aircraft_registration": {
      "type": "string",
      "description": "Kennzeichen des zugeordneten Flugzeugs"
    },
    "aircraft_mtow_tonnes": {
      "type": "number",
      "description": "MTOW des zugeordneten Flugzeugs in Tonnen"
    },
    "stops": {
      "type": "array",
      "description": "Liste der Stationen (Code, Name, Koordinaten)",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "sub": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "stops"
  ]
}